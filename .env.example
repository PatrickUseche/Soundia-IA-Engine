# Copia este archivo a .env y exporta las variables antes de levantar Django.
# Django NO lee .env por si solo: en PowerShell usa $env:NOMBRE="valor".
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
AUDIO_MAX_UPLOAD_BYTES=52428800
MEDIA_ROOT=media
